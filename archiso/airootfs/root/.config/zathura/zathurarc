# Flynn OS — zathura (PDF reader) · ENCOM Grid
set default-bg              "#02060c"
set default-fg              "#dff6ff"
set statusbar-bg            "#06131e"
set statusbar-fg            "#6f8f9c"
set inputbar-bg             "#06131e"
set inputbar-fg             "#dff6ff"
set completion-bg           "#12141c"
set completion-fg           "#b9d5e0"
set completion-highlight-bg "#22303d"
set completion-highlight-fg "#ffffff"
set notification-bg         "#06131e"
set notification-fg         "#38e8ff"
set notification-error-bg   "#06131e"
set notification-error-fg   "#ff5545"
set highlight-color         "rgba(159,220,245,0.35)"
set highlight-active-color  "rgba(159,220,245,0.6)"

# Dark mode for any PDF: 'r' toggles recolor
set recolor                 true
set recolor-darkcolor       "#dcedf7"
set recolor-lightcolor      "#0c0e14"
set recolor-keephue         true
map r recolor

set selection-clipboard     clipboard
set adjust-open             best-fit
set scroll-step             80
set guioptions              none
set statusbar-home-tilde    true
